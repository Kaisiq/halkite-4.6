#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_DIR="$ROOT_DIR/.venv"

pick_python() {
  local candidates=("python3.14" "python3")
  local candidate

  for candidate in "${candidates[@]}"; do
    if command -v "$candidate" >/dev/null 2>&1; then
      if "$candidate" - <<'EOF' >/dev/null 2>&1
import sys
version = sys.version_info
valid = (
    version.major == 3
    and version.minor == 14
    and not (version.micro == 1)
)
raise SystemExit(0 if valid else 1)
EOF
      then
        echo "$candidate"
        return 0
      fi
    fi
  done

  return 1
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name" >&2
    exit 1
  fi
}

main() {
  require_command pnpm

  if ! PYTHON_BIN="$(pick_python)"; then
    cat >&2 <<'EOF'
Missing a supported Python runtime.

Install Python 3.14 (except 3.14.1), then rerun:
  ./bin/setup
EOF
    exit 1
  fi

  echo "Using Python: $PYTHON_BIN"
  echo "Installing workspace dependencies with pnpm..."
  pnpm install --dir "$ROOT_DIR"

  if [[ ! -d "$VENV_DIR" ]]; then
    echo "Creating backend virtual environment at .venv..."
    "$PYTHON_BIN" -m venv "$VENV_DIR"
  fi

  # shellcheck disable=SC1091
  source "$VENV_DIR/bin/activate"

  echo "Ensuring pip is available in the virtual environment..."
  python -m ensurepip --upgrade >/dev/null 2>&1 || true

  echo "Installing backend package in editable mode..."
  python -m pip install -e "$ROOT_DIR/apps/api[dev]"

  echo
  echo "Setup complete."
  echo
  echo "Next steps:"
  echo "  ./bin/dev                     # start API + frontend (in-memory sessions)"
  echo "  docker compose up --build -d  # start full stack with MongoDB persistence"
  echo
  echo "Optional: set MONGODB_URI in .env for persistent sessions without Docker."
}

main "$@"
