#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_DIR="$ROOT_DIR/.venv"

pick_python() {
  local candidates=("python3.13" "python3.12")
  local candidate

  for candidate in "${candidates[@]}"; do
    if command -v "$candidate" >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done

  return 1
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name" >&2
    exit 1
  fi
}

main() {
  require_command pnpm

  if ! PYTHON_BIN="$(pick_python)"; then
    cat >&2 <<'EOF'
Missing a supported Python runtime.

Install Python 3.12 or 3.13, then rerun:
  ./bin/setup
EOF
    exit 1
  fi

  echo "Using Python: $PYTHON_BIN"
  echo "Installing workspace dependencies with pnpm..."
  pnpm install --dir "$ROOT_DIR"

  if [[ ! -d "$VENV_DIR" ]]; then
    echo "Creating backend virtual environment at .venv..."
    "$PYTHON_BIN" -m venv "$VENV_DIR"
  fi

  # shellcheck disable=SC1091
  source "$VENV_DIR/bin/activate"

  echo "Ensuring pip is available in the virtual environment..."
  python -m ensurepip --upgrade >/dev/null 2>&1 || true

  echo "Upgrading pip..."
  python -m pip install --upgrade pip

  echo "Installing backend package in editable mode..."
  python -m pip install -e "$ROOT_DIR/apps/api[dev]"

  echo
  echo "Setup complete."
  echo "Next step:"
  echo "  ./bin/dev"
}

main "$@"

