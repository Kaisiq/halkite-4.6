#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_DIR="$ROOT_DIR/.venv"
BACKEND_ENTRY="$ROOT_DIR/apps/api/src/nexus_api/main.py"
FRONTEND_LAYOUT="$ROOT_DIR/apps/web/app/layout.tsx"
FRONTEND_PAGE="$ROOT_DIR/apps/web/app/page.tsx"

require_file() {
  local path="$1"
  local message="$2"

  if [[ ! -f "$path" ]]; then
    echo "$message" >&2
    exit 1
  fi
}

cleanup() {
  local exit_code=$?

  if [[ -n "${API_PID:-}" ]]; then
    kill "$API_PID" >/dev/null 2>&1 || true
  fi

  if [[ -n "${WEB_PID:-}" ]]; then
    kill "$WEB_PID" >/dev/null 2>&1 || true
  fi

  wait >/dev/null 2>&1 || true
  exit "$exit_code"
}

main() {
  if [[ ! -d "$VENV_DIR" ]]; then
    echo "Missing .venv. Run ./bin/setup first." >&2
    exit 1
  fi

  require_file "$BACKEND_ENTRY" "Missing backend entrypoint: apps/api/src/nexus_api/main.py"
  require_file "$FRONTEND_LAYOUT" "Missing frontend layout: apps/web/app/layout.tsx"
  require_file "$FRONTEND_PAGE" "Missing frontend page: apps/web/app/page.tsx"

  # shellcheck disable=SC1091
  source "$VENV_DIR/bin/activate"

  trap cleanup EXIT INT TERM

  echo "Starting backend..."
  (
    cd "$ROOT_DIR"
    pnpm --filter @halkite/api dev
  ) &
  API_PID=$!

  echo "Starting frontend..."
  (
    cd "$ROOT_DIR"
    pnpm --filter @halkite/web dev
  ) &
  WEB_PID=$!

  wait -n "$API_PID" "$WEB_PID"
}

main "$@"

