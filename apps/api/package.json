{
  "name": "@halkite/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "python -m fastapi dev src/nexus_api/main.py",
    "build": "python -m compileall src",
    "lint": "python -m ruff check src tests",
    "lint:fix": "python -m ruff check --fix src tests",
    "format": "python -m ruff format src tests",
    "format:check": "python -m ruff format --check src tests",
    "typecheck": "python -m mypy src tests",
    "test": "python -m pytest",
    "test:cov": "python -m pytest --cov --cov-report=term-missing",
    "test:unit": "python -m pytest -m 'not slow and not integration'",
    "test:integration": "python -m pytest -m integration",
    "quality": "python -m ruff check src tests && python -m ruff format --check src tests"
  }
}
