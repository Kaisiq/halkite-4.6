{
  "name": "halkantir",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "setup": "./bin/setup",
    "dev": "./bin/dev",
    "dev:turbo": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "turbo run quality",
    "test": "turbo run test",
    "test:cov": "pnpm --filter @halkantir/api test:cov"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "turbo": "2.8.20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
